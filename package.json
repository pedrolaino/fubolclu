{
  "name": "fubolclu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed/index.ts",
    "sync": "tsx --env-file-if-exists=.env scripts/sync.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
